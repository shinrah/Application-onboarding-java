pipeline {
    agent { label 'BuildAgent' }

    parameters {
        choice(name: 'GIT_Branch_Tag', choices: ['ISS_UAT_RELEASE'], description: 'Fixed branch')
        choice(name: 'Mode', choices: ['Deploy'], description: 'Deploy and upload artifacts')
    }

    stages {
        stage('Build and Upload Artifacts') {
            when { expression { params.Mode == "Deploy" } }
            steps {
                script {
                    currentBuild.displayName = "${params.GIT_Branch_Tag}_${BUILD_NUMBER}"

                    def giturl = "https://github.com/shinrah/JAVA-Application-.git"
                    // def artifactServer = Artifactory.server 'DevOpsArtifactory01'
                    // def artifactBuildInfo = Artifactory.newBuildInfo()
                    // def artifactMaven = Artifactory.newMavenBuild()
                    // artifactMaven.tool = 'MVN388'

                    cleanWs()
                    
                    echo '[Stage] Checkout Code'
                    checkout([$class: 'GitSCM',
                        branches: [[name: "${params.GIT_Branch_Tag}"]],
                        userRemoteConfigs: [[credentialsId: 'sapdevopsgit', url: "${giturl}"]]
                    ])

                    echo '[Stage] Building + Sonar'
                    sh "echo JDK Location: ${tool 'APPLEJDK17'}"
                    // withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    withMaven(jdk: 'APPLEJDK17', maven: 'MVN388', mavenLocalRepo: '.m2repo') {
                        withEnv([
                            "JAVA_HOME=/usr/lib/jvm/java-17-openjdk-17.0.1.0.12-2.el8_5.x86_64",
                            "PATH=/usr/lib/jvm/java-17-openjdk-17.0.1.0.12-2.el8_5.x86_64/bin:$PATH"
                        ]) {
                            sh """
                                java -version
                                mvn -v
                                mvn clean install 

                            """
                        }
                    }  // END withMaven
                    // } // END withCredentials
                }  // END script
            }  // END steps
        }  // END stage
    }  // END stages
}  // END pipeline
