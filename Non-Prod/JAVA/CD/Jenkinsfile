pipeline {
    agent any

    parameters {
        string(name: 'BUILD_NUMBER', defaultValue: '', description: 'Enter CI build number to deploy')
    }

    environment {
        AWS_REGION = 'ap-south-1'
        S3_BUCKET = 'rahul-jenkins-artifacts'
        WAR_FILE = 'webapp.war'                // The local file name after download
        WAR_S3_PATH = "builds/${params.BUILD_NUMBER}/webapp.war" // Adjust this if folder name differs
        TOMCAT_URL = 'http://13.127.233.188:8080'
        TOMCAT_CREDENTIALS = 'tomcat-deployer'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Download WAR from S3') {
            steps {
                script {
                    echo "🔽 Downloading WAR file for build #${params.BUILD_NUMBER} from S3..."
                    withAWS(credentials: '510891f4-2632-4680-ad11-9f52e0e5bf16', region: "${env.AWS_REGION}") {
                        s3Download(
                            bucket: "${env.S3_BUCKET}",
                            file: "${env.WAR_FILE}",   // Local file name
                            path: "${env.WAR_S3_PATH}" // Remote path in S3
                        )
                    }
                }
            }
        }

        stage('Verify WAR File Exists') {
            steps {
                script {
                    if (!fileExists("${env.WAR_FILE}")) {
                        error("❌ WAR file not found after S3 download. Check your S3 path or build number.")
                    } else {
                        echo "✅ WAR file downloaded successfully: ${env.WAR_FILE}"
                    }
                }
            }
        }

        stage('Deploy WAR to Tomcat') {
            steps {
                echo "🚀 Deploying ${env.WAR_FILE} to Tomcat at ${env.TOMCAT_URL}..."
                deploy adapters: [
                    tomcat9(
                        credentialsId: "${env.TOMCAT_CREDENTIALS}",
                        path: '',
                        url: "${env.TOMCAT_URL}"
                    )
                ],
                contextPath: 'webapp',  // App will run at http://13.127.233.188:8080/webapp/
                war: "${env.WAR_FILE}"
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    echo "🔍 Verifying deployment on Tomcat..."
                    sh "curl -I ${env.TOMCAT_URL}/webapp/ || true"
                }
            }
        }
    }

    post {
        success {
            echo "✅ Deployment completed successfully for build #${params.BUILD_NUMBER}"
        }
        failure {
            echo "❌ Deployment failed. Check Jenkins logs for details."
        }
    }
}
